---
import Tag from './Tag.astro';
import GradientOrbs from './GradientOrbs.astro';

interface Props {
  project: {
    title: string;
    description: string;
    url?: string;
    repo?: string;
    tags: string[];
    featured: boolean;
    date: Date;
    coverImage?: string;
  };
  href?: string;
}

const { project, href } = Astro.props;
---

<div
  class="group relative h-full w-full rounded-2xl p-4 overflow-hidden"
  transition:name={`project-${project.title}`}
>
  <div class="absolute inset-0 z-0 pointer-events-none">
    <GradientOrbs />
  </div>

  <div
    class="relative z-10 flex h-full flex-col justify-between rounded-xl bg-bg-secondary p-6"
  >
    <div class="mb-6 flex-1">
      <div class="flex flex-row justify-between items-start">
        <h3 class="text-text text-2xl mb-2">
          {project.title}
        </h3>
        {
          project.featured && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="size-5 text-text-secondary"
            >
              <path
                fill-rule="evenodd"
                d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z"
                clip-rule="evenodd"
              />
            </svg>
          )
        }
      </div>

      <p class="text-text-secondary font-sans">
        {project.description}
      </p>
    </div>

    <div class="flex items-center justify-between gap-4">
      <div class="relative min-w-0 flex-1">
        <div
          class="no-scrollbar flex items-center gap-1.5 overflow-x-auto pr-6"
        >
          {project.tags.map((tag: string) => <Tag text={tag} />)}
        </div>

        <div
          class="pointer-events-none absolute inset-y-0 right-0 w-8 bg-linear-to-l from-bg-secondary to-transparent"
        >
        </div>
      </div>

      <a
        href={href}
        class="shrink-0 inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-text transition-colors hover:bg-secondary select-none"
      >
        <span>View Project</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="size-4"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
        </svg>
      </a>
    </div>
  </div>
</div>
