---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const allPosts = await getCollection('blogs');

const posts = allPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const months = [
  'January',
  'February',
  'March',
  'April',
  'May',
  'June',
  'July',
  'August',
  'September',
  'October',
  'November',
  'December',
];
---

<BaseLayout title="Blogs">
  <div class="mb-12">
    <h1 class="text-text text-5xl mb-4">Blog Posts</h1>
    <p class="pr-8 sm:pr-0 sm:w-xl text-text-secondary font-sans">
      Check out my blog posts below.
    </p>
  </div>
  {
    posts.length ? (
      <div class="mb-12 card flex flex-col gap-4">
        {posts.map((post) => (
          <a
            href={`/blogs/${post.id}`}
            class="rounded-lg bg-bg p-4 cursor-pointer hover:bg-bg/80 transition-colors"
          >
            <div class="mb-2 flex flex-row gap-2 items-center justify-between">
              <h2
                class="text-text xs:text-xl sm:text-2xl"
                transition:name={`blog-${post.data.title}`}
              >
                {post.data.title}
              </h2>
              <p class="hidden sm:block text-text-secondary font-sans">
                {months[post.data.date.getMonth()]} {post.data.date.getDate()},{' '}
                {post.data.date.getFullYear()}
              </p>
              <p class="sm:hidden text-text-secondary font-sans">
                {post.data.date.getMonth() + 1}/{post.data.date.getFullYear()}
              </p>
            </div>
            <p class="hidden md:block text-text-secondary font-sans">
              {post.data.description}
            </p>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-secondary font-sans">
        Nothing to see here... yet. Check back later!
      </p>
    )
  }
</BaseLayout>
